# Copie este arquivo para C:/Users/Zion/asf-app-local/.env.cron (fora do repo!)
# e preencha com um PAT com escopo repo (ou fine-grained com contents:read).
# O monitor-loop.sh faz source deste arquivo e exporta GITHUB_TOKEN a partir de GH_TOKEN.
GH_TOKEN=ghp_substitua_pelo_seu_token
